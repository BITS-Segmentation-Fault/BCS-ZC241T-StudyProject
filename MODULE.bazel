module(
    name = "study_project",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "2.0.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "sandbox_go_sdk",
    go_mod = "//sandbox/sandbox:go.mod",
)
use_repo(
    go_sdk,
    "go_host_compatible_sdk_label",
    "go_toolchains",
    "io_bazel_rules_nogo",
)

register_toolchains("@go_toolchains//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//sandbox/sandbox:go.mod")
use_repo(
    go_deps,
    "in_gopkg_yaml_v3",
    "org_golang_x_sys",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

typst = use_extension("//tools/typst:extensions.bzl", "typst")
typst.toolchain(version = "0.14.2")
use_repo(typst, "typst_toolchains")

register_toolchains("@typst_toolchains//:all")
