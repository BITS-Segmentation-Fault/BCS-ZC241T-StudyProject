module(
    name = "study_project",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

TYPST_VERSION = "0.14.2"

TYPST_METADATA = {
    "typst-aarch64-unknown-linux-musl": {
        "version": TYPST_VERSION,
        "sha256": "491b101aa40a3a7ea82a3f8a6232cabb4e6a7e233810082e5ac812d43fdcd47a",
    },
    "typst-x86_64-unknown-linux-musl": {
        "version": TYPST_VERSION,
        "sha256": "a6044cbad2a954deb921167e257e120ac0a16b20339ec01121194ff9d394996d",
    },
}

[
    http_archive(
        name = name,
        build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "typst_bin", srcs = ["typst"])
""",
        sha256 = meta["sha256"],
        strip_prefix = name,
        urls = [
            "https://github.com/typst/typst/releases/download/v%s/%s.tar.xz" % (
                meta["version"],
                name,
            ),
        ],
    )
    for name, meta in TYPST_METADATA.items()
]
